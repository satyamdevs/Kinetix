# Dashboard environment
# Where the gateway admin API lives and which key to use. The key must be
# provisioned in the gateway with the "admin" scope (e.g. ORCA_ADMIN_KEY in
# the gateway's in-memory seed, or via orca-keys set-scopes).

# Base URL of the gateway (no trailing slash)
ORCA_GATEWAY_URL=http://localhost:8080

# Admin API key (server-only; never render in client components)
ORCA_ADMIN_KEY=sk-orca-dev-admin-key