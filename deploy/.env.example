# Orca development environment
# Copy to deploy/.env and adjust as needed. Compose falls back to these
# same defaults when no .env file is present.

POSTGRES_USER=orca
POSTGRES_PASSWORD=orca

CLICKHOUSE_USER=orca
CLICKHOUSE_PASSWORD=orca

ORCA_PORT=8080
ORCA_API_KEYS=sk-orca-dev-key

# Governance (Phase 3)
# When POSTGRES_DSN is unset the gateway keeps API keys in memory, seeded
# from ORCA_API_KEYS. Point it at the dev postgres to use the api_keys table.
# Provision production keys with: make build-keys && bin/orca-keys -dsn "$POSTGRES_DSN" create ...
POSTGRES_DSN=postgres://orca:orca@localhost:5432/orca
# REDIS_ADDR=localhost:6379   # unset => in-memory limiter
# Gateway-wide defaults applied to keys that don't override their own limit:
ORCA_DEFAULT_RPM=1000
ORCA_DEFAULT_TPM=100000000
# Optional content guardrails: ;-separated "name|regex|role" (input|output|both)
# ORCA_GUARDRAILS=pii|[A-Z]{4}-[0-9]{4}|input;secret|top\s+secret|both

# Providers (Phase 2)
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_BASE_URL=https://api.openai.com/v1

# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# ANTHROPIC_API_VERSION=2023-06-01

# OLLAMA_BASE_URL=http://localhost:11434/v1

# Fallback aliases route across providers in order:
# orca-fast  = gpt-4o-mini -> claude-3-5-haiku -> llama3.2
# orca-smart = gpt-4o -> claude-3-5-sonnet -> llama3.1